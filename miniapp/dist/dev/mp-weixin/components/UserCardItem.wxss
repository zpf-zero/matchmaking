/* 全局设计变量。改这里就能整体换肤 */
.user-card.data-v-c201bdda {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  position: relative;
}
.avatar.data-v-c201bdda {
  width: 160rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  flex-shrink: 0;
}
.info.data-v-c201bdda {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.name-row.data-v-c201bdda {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}
.name.data-v-c201bdda {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.match.data-v-c201bdda {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: #e8506d;
  background: #fff0f3;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}
.tags.data-v-c201bdda {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 14rpx;
}
.tag.data-v-c201bdda {
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  background: #f5f6f8;
  color: #646a73;
}
.tag-brand.data-v-c201bdda {
  background: #fff0f3;
  color: #e8506d;
}
.meta.data-v-c201bdda {
  font-size: 24rpx;
  color: #646a73;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sep.data-v-c201bdda {
  margin: 0 8rpx;
  color: #d9dce0;
}
.active.data-v-c201bdda {
  margin-top: auto;
  font-size: 22rpx;
  color: #bbbfc4;
}
.like.data-v-c201bdda {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 50%;
  background: #f5f6f8;
  color: #8a8f99;
  font-size: 34rpx;
}
.like.on.data-v-c201bdda {
  background: #fff0f3;
  color: #e8506d;
}