/* 全局设计变量。改这里就能整体换肤 */
.chat.data-v-da04a0a0 {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f6f8;
}
.msg-area.data-v-da04a0a0 {
  flex: 1;
  overflow: hidden;
}
.msg-list.data-v-da04a0a0 {
  padding: 24rpx;
}
.history-tip.data-v-da04a0a0,
.safe-notice.data-v-da04a0a0 {
  text-align: center;
  font-size: 22rpx;
  color: #bbbfc4;
  padding: 16rpx 40rpx;
  line-height: 1.6;
}
.safe-notice.data-v-da04a0a0 {
  background: #fff7e8;
  color: #ff8f1f;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}
.msg.data-v-da04a0a0 {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 28rpx;
}
.msg.mine.data-v-da04a0a0 {
  align-items: flex-end;
}
.bubble.data-v-da04a0a0 {
  max-width: 76%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #fff;
  font-size: 29rpx;
  line-height: 1.5;
  color: #1f2329;
  word-break: break-all;
}
.mine .bubble.data-v-da04a0a0 {
  background: #e8506d;
  color: #fff;
}
.img-msg.data-v-da04a0a0 {
  max-width: 400rpx;
  border-radius: 16rpx;
  background: #fff;
}
.msg-meta.data-v-da04a0a0 {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #bbbfc4;
}
.failed.data-v-da04a0a0 {
  color: #f53f3f;
}
.input-bar.data-v-da04a0a0 {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #ebedf0;
}
.input.data-v-da04a0a0 {
  flex: 1;
  height: 76rpx;
  background: #f5f6f8;
  border-radius: 38rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}
.ph.data-v-da04a0a0 {
  color: #bbbfc4;
}
.img-btn.data-v-da04a0a0 {
  margin-left: 16rpx;
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 34rpx;
}
.send-btn.data-v-da04a0a0 {
  margin-left: 12rpx;
  padding: 0 32rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  background: #ebedf0;
  color: #bbbfc4;
  font-size: 28rpx;
}
.send-btn.active.data-v-da04a0a0 {
  background: #e8506d;
  color: #fff;
}
.more-bar.data-v-da04a0a0 {
  background: #fff;
  text-align: center;
  font-size: 22rpx;
  color: #bbbfc4;
  padding: 12rpx 0 calc(12rpx + env(safe-area-inset-bottom));
}