/* 全局设计变量。改这里就能整体换肤 */
.page.data-v-bdafde18 {
  padding: 20rpx 24rpx 40rpx;
}
.entries.data-v-bdafde18 {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 0;
  margin-bottom: 28rpx;
}
.entry.data-v-bdafde18 {
  flex: 1;
  text-align: center;
  position: relative;
}
.entry-icon.data-v-bdafde18 {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0 auto 14rpx;
  border-radius: 50%;
  font-size: 38rpx;
}
.entry-icon.like.data-v-bdafde18 {
  background: #fff0f3;
  color: #e8506d;
}
.entry-icon.mine.data-v-bdafde18 {
  background: #fff7e8;
  color: #ff8f1f;
}
.entry-icon.view.data-v-bdafde18 {
  background: #eef5ff;
  color: #3f7ef5;
}
.entry-text.data-v-bdafde18 {
  font-size: 24rpx;
  color: #646a73;
}
.badge.data-v-bdafde18 {
  position: absolute;
  top: -6rpx;
  right: 50rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #f53f3f;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
}
.section-title.data-v-bdafde18 {
  font-size: 28rpx;
  font-weight: 600;
  padding: 8rpx 8rpx 20rpx;
}
.conv-list.data-v-bdafde18 {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.conv.data-v-bdafde18 {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f2f3f5;
}
.conv.data-v-bdafde18:last-child {
  border-bottom: none;
}
.avatar-wrap.data-v-bdafde18 {
  position: relative;
  flex-shrink: 0;
}
.avatar.data-v-bdafde18 {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f5f6f8;
}
.online.data-v-bdafde18 {
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #00b578;
  border: 3rpx solid #fff;
}
.unread.data-v-bdafde18 {
  position: absolute;
  top: -6rpx;
  right: -10rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #f53f3f;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
}
.conv-main.data-v-bdafde18 {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}
.conv-top.data-v-bdafde18 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}
.conv-name.data-v-bdafde18 {
  font-size: 30rpx;
  font-weight: 500;
}
.conv-time.data-v-bdafde18 {
  font-size: 22rpx;
  color: #bbbfc4;
}
.conv-msg.data-v-bdafde18 {
  font-size: 26rpx;
  color: #8a8f99;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}