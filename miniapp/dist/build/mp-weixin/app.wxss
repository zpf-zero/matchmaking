page{background-color:#f5f6f8;color:#1f2329;font-size:28rpx;font-family:-apple-system,BlinkMacSystemFont,Helvetica Neue,Helvetica,sans-serif}.card{background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:20rpx}.row{display:flex;align-items:center}.row-between{display:flex;align-items:center;justify-content:space-between}.btn-primary{background:#e8506d;color:#fff;border-radius:44rpx;height:88rpx;line-height:88rpx;text-align:center;font-size:30rpx}.btn-primary.disabled{background:#f0c2cc}.btn-plain{background:#fff;color:#646a73;border:1rpx solid #ebedf0;border-radius:44rpx;height:88rpx;line-height:88rpx;text-align:center;font-size:30rpx}.empty{padding:120rpx 40rpx;text-align:center;color:#8a8f99;font-size:28rpx}.tag{display:inline-block;padding:4rpx 14rpx;border-radius:6rpx;font-size:22rpx;background:#f5f6f8;color:#646a73;margin-right:10rpx}.tag-brand{background:#fff0f3;color:#e8506d}
page{--status-bar-height:25px;--top-window-height:0px;--window-top:0px;--window-bottom:0px;--window-left:0px;--window-right:0px;--window-magin:0px}[data-c-h="true"]{display: none !important;}