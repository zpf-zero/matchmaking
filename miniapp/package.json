{
  "name": "hunjie-miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "婚介小程序（含管理页面）",
  "scripts": {
    "config:dev": "node scripts/generate-config.mjs dev",
    "config:prod": "node scripts/generate-config.mjs prod",
    "predev:mp-weixin": "npm run config:dev",
    "dev:mp-weixin": "uni -p mp-weixin",
    "prebuild:mp-weixin": "npm run config:prod",
    "build:mp-weixin": "uni build -p mp-weixin",
    "predev:h5": "npm run config:dev",
    "dev:h5": "uni",
    "prebuild:h5": "npm run config:prod",
    "build:h5": "uni build"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5020320260731001",
    "@dcloudio/uni-components": "3.0.0-alpha-5020320260731001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5020320260731001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020320260731001",
    "pinia": "^2.1.7",
    "playwright": "^1.62.1",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-5020320260731001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020320260731001",
    "sass": "^1.77.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.8"
  }
}
