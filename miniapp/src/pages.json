  "globalStyle": {
    "navigationBarTextStyle": "@navTxtStyle",
    "navigationBarTitleText": "缘来婚恋",
    "navigationBarBackgroundColor": "@navBgColor",
    "backgroundColor": "@bgColor"
  },
  "darkmode": true,
  "themeLocation": "theme.json",
  "//": "darkmode + themeLocation 让导航栏和 tabBar 跟随系统深浅色。它们是原生控件，拿不到 App.vue 的 CSS 变量，只能走这套主题机制（微信基础库 2.11+）。不配的话深色模式下内容区变暗、底部导航条还是白的。",
  "tabBar": {
    "color": "@tabColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBg",
    "borderStyle": "@tabBorderStyle",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "推荐",
        "iconPath": "@tabHome",
        "selectedIconPath": "@tabHomeActive"
      },
      {
        "pagePath": "pages/search/index",
        "text": "筛选",
        "iconPath": "@tabSearch",
        "selectedIconPath": "@tabSearchActive"
      },
      {
        "pagePath": "pages/message/index",
        "text": "消息",
        "iconPath": "@tabMessage",
        "selectedIconPath": "@tabMessageActive"
      },
      {
        "pagePath": "pages/mine/index",
        "text": "我的",
        "iconPath": "@tabMine",
        "selectedIconPath": "@tabMineActive"
      }
    ]
  }
}
